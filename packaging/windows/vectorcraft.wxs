<?xml version="1.0" encoding="utf-8"?>
<!--
  Vector Avelton MSI (WiX Toolset v5: `dotnet tool install -g wix`, plus the UI and Util extensions:
  `wix extension add -g WixToolset.UI.wixext/5.0.2 WixToolset.Util.wixext/5.0.2`). Built by package.ps1:

    wix build vectorcraft.wxs -arch x64 -ext WixToolset.UI.wixext -ext WixToolset.Util.wixext
      -culture en-US -loc vectorcraft.en-us.wxl -d Version=1.2.3 -d DisplayVersion=1.2.3-rc.1
      -d BinDir=... -d IconPath=... -d BannerBmp=... -d DialogBmp=... -o out.msi

  Per-machine install with a setup wizard that names the version: Welcome, install folder (Program Files\Vector Avelton by
  default, remembered for upgrades), Ready, a progress page, and a Finish page with a ticked
  "Launch Vector Avelton" box. Installs a Start Menu shortcut and an App Paths entry (so `vectorcraft`
  starts from the Run dialog), plus vectorcraft-cli. `msiexec /qn` still installs silently.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui">
  <Package
      Name="Vector Avelton"
      Manufacturer="Avelton"
      Version="$(var.Version)"
      UpgradeCode="ADEF91BD-766F-5DCE-887C-C5742C1711C8"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="Vector Avelton vector illustration app" Manufacturer="Avelton" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of Vector Avelton is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="VectorcraftIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="VectorcraftIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://vector.avelton.online" />
    <Property Id="ARPURLUPDATEINFO" Value="https://vector.avelton.online" />
    <Property Id="ARPHELPLINK" Value="https://github.com/avelton-ai/vector-avelton/issues" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="Vector Avelton" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <!-- An upgrade installs where the user put the previous version (written by VectorcraftApp). -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="PreviousInstallFolder" Root="HKLM" Key="Software\Vector Avelton" Name="InstallDir" Type="raw" />
    </Property>

    <Feature Id="Main" Title="Vector Avelton" Level="1">
      <ComponentGroupRef Id="VectorcraftFiles" />
    </Feature>

    <!-- The setup wizard: WixUI_InstallDir without its licence page (the code is MIT OR
         Apache-2.0; there is nothing to accept). A later NewDialog on the same button wins. -->
    <ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
    <UI>
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="2" Condition="NOT Installed" />
      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchVectorcraft"
          Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 AND NOT Installed" />
    </UI>
    <!-- Our own art, generated by package.ps1 from the app icon (not WiX's stock bitmaps). -->
    <WixVariable Id="WixUIBannerBmp" Value="$(var.BannerBmp)" />
    <WixVariable Id="WixUIDialogBmp" Value="$(var.DialogBmp)" />

    <!-- The full version (Version is numeric, so it drops a pre-release tag), shown on the wizard's
         pages through vectorcraft.en-us.wxl. -->
    <Property Id="VectorcraftVersion" Value="$(var.DisplayVersion)" />

    <!-- Finish page: say where to find the app, and offer to start it (ticked by default). -->
    <Property Id="WIXUI_EXITDIALOGOPTIONALTEXT" Value="Vector Avelton $(var.DisplayVersion) is installed. You can start it any time from the Start menu." />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Launch Vector Avelton" />
    <Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
    <Property Id="WixShellExecTarget" Value="[#VectorcraftExe]" />
    <!-- Runs in the wizard's own (unelevated) process, so the app starts as the user, not as admin. -->
    <CustomAction Id="LaunchVectorcraft" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" DllEntry="WixShellExec" Impersonate="yes" Return="ignore" />
  </Package>

  <Fragment>
    <ComponentGroup Id="VectorcraftFiles" Directory="INSTALLFOLDER">
      <Component Id="VectorcraftApp" Guid="FCA6721D-640D-538F-A5B8-91AD85250162">
        <File Id="VectorcraftExe" Source="$(var.BinDir)\vector-avelton.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Vector Avelton"
              Description="Vector Avelton vector illustration app" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="VectorcraftIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\vector-avelton.exe" Value="[#VectorcraftExe]" Type="string" />
        <RegistryValue Root="HKLM" Key="Software\Vector Avelton" Name="InstallDir" Value="[INSTALLFOLDER]" Type="string" />
      </Component>

      <Component Id="VectorcraftCli">
        <File Id="VectorcraftCliExe" Source="$(var.BinDir)\vector-avelton-cli.exe" KeyPath="yes" />
      </Component>
      <Component Id="AveltonNotices" Guid="E74E0544-B44B-5C4B-89E0-555C9EC09B82">
        <File Id="AveltonNotice0" Source="$(sys.SOURCEFILEDIR)..\..\NOTICE" />
        <File Id="AveltonNotice1" Source="$(sys.SOURCEFILEDIR)..\..\avelton.json" />
        <File Id="AveltonNotice2" Source="$(sys.SOURCEFILEDIR)..\..\assets\fonts\OFL-Inter.txt" />
        <File Id="AveltonNotice3" Source="$(sys.SOURCEFILEDIR)..\..\assets\fonts\OFL-JetBrainsMono.txt" />
        <File Id="AveltonNotice4" Source="$(sys.SOURCEFILEDIR)..\..\assets\fonts\OFL-SourceSans3.txt" />
        <File Id="AveltonNotice5" Source="$(sys.SOURCEFILEDIR)..\..\assets\fonts\OFL-SourceSerif4.txt" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
